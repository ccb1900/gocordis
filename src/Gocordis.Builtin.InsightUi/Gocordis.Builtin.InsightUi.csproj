<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Gocordis.Core/Gocordis.Core.csproj" />
    <ProjectReference Include="../Gocordis.Plugins/Gocordis.Plugins.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="wwwroot/client-modules/**/*"
             Link="client-modules/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
