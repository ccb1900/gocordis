<Project Sdk="Microsoft.NET.Sdk">
  <!-- Contracts-only assembly: stable keys, interfaces and DTOs shared by host
       and third-party plugins. No ASP.NET Core framework reference, no service
       implementations. Keeps the Gocordis.Extensions namespace so existing
       plugin sources continue to compile with the SDK's global using. -->
  <ItemGroup>
    <ProjectReference Include="../Gocordis.Core/Gocordis.Core.csproj" />
    <ProjectReference Include="../Gocordis.Plugins/Gocordis.Plugins.csproj" />
  </ItemGroup>
</Project>
