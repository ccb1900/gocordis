# Build output directories are ignored, but the SDK's packaged MSBuild props
# is source (it is what re-exports the authoring surface to plugin projects).
build/
!src/Gocordis.Plugin.Sdk/build/
!src/Gocordis.Plugin.Sdk/build/Gocordis.Plugin.Sdk.props
web/console/node_modules/
web/console-runtime/node_modules/
src/Gocordis.Builtin.WebConsole/frontend/node_modules/
src/Gocordis.Builtin.ControlPlaneUi/frontend/node_modules/
src/Gocordis.Builtin.InsightUi/frontend/node_modules/
# plugin-kit emits it next to the bundle; pages are declared in C#.
src/Gocordis.Builtin.*/wwwroot/client-modules/**/gocordis-ui.json
# web/console/dist is tracked: `dotnet run` from a fresh checkout must serve
# the real React console without requiring a separate npm build step.

# Dependencies are reproducible from their lockfiles — never tracked.
client/node_modules/
web/plugin-kit/node_modules/
samples/SpatiotemporalShowcase/UiClientModule/frontend/node_modules/

# Build artifacts: `go build ./cmd/backfill` writes ./backfill by default.
/backfill

# ZCode harness session state — local tool metadata, never source
.zcode/

# Generated local verification artifacts (reports remain tracked)
industrial/web/node_modules/
industrial/web/test-results/
industrial/web/playwright-report/
artifacts/test-report/*.log
artifacts/test-report/*.code
__pycache__/
*.pyc

# .NET build artifacts (migration/dotnet)
TestResults/
bin/
obj/
.vs/
*.user

# BenchmarkDotNet generated artifacts
BenchmarkDotNet.Artifacts/

# Locally packed SDK feed for plugin development
local-packages/

# Uploaded review artifacts / Windows alternate data streams
*:Zone.Identifier

# Uploaded review artifacts (not source)
docs/gocordis-paper-chapter-coverage-matrix.md
